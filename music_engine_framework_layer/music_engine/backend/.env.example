# Copy to .env for local dev — Kalkee needs almost nothing of its own
# (see app/config.py): it's a stateless routing decision service, no
# provider API keys, no chat/session state.

# local (a per-table JSON file under DATA_DIR) | dynamodb
STORAGE_BACKEND=local
DATA_DIR=./data

# Only read when STORAGE_BACKEND=dynamodb. Point DYNAMO_ENDPOINT at
# Kalkee's own DynamoDB-local instance in dev so RouterConfig/
# RoutingOutcomes/ModelBenchmarks are visible to both services without
# standing up a second database.
DYNAMO_ENDPOINT=
AWS_REGION=ap-south-1
